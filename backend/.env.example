# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (Prisma)
# Local default: file-based SQLite (no server required).
DATABASE_URL="file:./dev.db"
# To use PostgreSQL instead, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and use a URL like:
# DATABASE_URL=postgresql://user:password@localhost:5432/notebook_chatbot

# --- Other integrations to wire up for production (placeholders) ---

# Object storage (S3-compatible)
S3_BUCKET=notebook-chatbot
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Vector database (e.g. Pinecone / Qdrant / pgvector)
VECTOR_DB_URL=

# LLM pipeline (OpenAI / LangChain)
OPENAI_API_KEY=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
