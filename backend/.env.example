# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (start with: docker compose up postgres -d)
DATABASE_URL="postgresql://notebook:notebook@localhost:5432/notebook_chatbot?schema=public"

# JWT authentication
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=notebook_chunks

# Redis (for future BullMQ worker — Milestone 2)
REDIS_URL=redis://localhost:6379

# RAG tuning
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.55

# Redis (BullMQ ingestion worker)
REDIS_URL=redis://localhost:6379

# Storage: local | s3
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3-compatible storage (when STORAGE_PROVIDER=s3)
# S3_BUCKET=notebook-chatbot
# S3_REGION=auto
# S3_ENDPOINT=https://...
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true

# RAG chunk tuning
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# LLM config (platform-only — students never configure this)
LLM_CONFIG_PATH=./config/llm.providers.json

# Platform LLM (optional override — defaults to first provider in llm.providers.json)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# Platform API keys (backend only — never expose to frontend)
DASHLAB_API_KEY=
OPENAI_API_KEY=
