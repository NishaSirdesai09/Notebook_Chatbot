# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (Prisma)
DATABASE_URL="file:./dev.db"

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=notebook_chunks

# RAG tuning
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.55

# File uploads (local storage)
UPLOAD_DIR=./uploads

# LLM config file (add providers/models here)
LLM_CONFIG_PATH=./config/llm.providers.json

# Qdrant vector database (needed for upload + chat search)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=notebook_chunks

# File uploads
UPLOAD_DIR=./uploads

# LLM config
LLM_CONFIG_PATH=./config/llm.providers.json

# DashLab — chat answers (GLM / Gemma). Get key from dashlab.studio → Keys tab
DASHLAB_API_KEY=

# OpenAI — optional; only if you switch embedding back to OpenAI in llm.providers.json
OPENAI_API_KEY=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
