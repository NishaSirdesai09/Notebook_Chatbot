// Notebook Chatbot — PostgreSQL schema (Milestone 1+)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Student") // Student | Professor | Admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notebooks     Notebook[]
  preferences   UserPreference?
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyMode      String   @default("balanced")
  responseLength String   @default("balanced")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notebook {
  id             String   @id @default(uuid())
  title          String
  course         String   @default("")
  description    String   @default("")
  subject        String   @default("General")
  visibility     String   @default("Private")
  files          Int      @default(0)
  status         String   @default("Processing")
  color          String   @default("from-brand-500 to-accent-purple")
  questionsAsked Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  documents Document[]
  messages  ChatMessage[]
  summaries Summary[]

  @@index([ownerId])
}

model Document {
  id                 String    @id @default(uuid())
  name               String
  type               String
  mimeType           String?
  size               String    @default("—")
  sizeBytes          Int?
  status             String    @default("queued")
  processingProgress Int       @default(0)
  processingStage    String?
  pages              Int?
  storageKey         String?
  storagePath        String?   // legacy local path — prefer storageKey
  errorMessage       String?
  uploadedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  indexedAt          DateTime?

  notebookId       String
  notebook         Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  uploadedByUserId String?

  chunks        DocumentChunk[]
  ingestionJobs IngestionJob[]

  @@index([notebookId])
  @@index([status])
}

model DocumentChunk {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex   Int
  pageNumber   Int
  qdrantPointId String
  tokenCount   Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model IngestionJob {
  id           String    @id @default(uuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING | ACTIVE | COMPLETED | FAILED | RETRYING
  progress     Int       @default(0)
  attemptCount Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentId])
  @@index([status])
}

model ChatMessage {
  id               String   @id @default(uuid())
  role             String
  content          String
  explanation      String?
  keyPoints        Json?
  practiceQuestion String?
  notFound         Boolean  @default(false)
  createdAt        DateTime @default(now())

  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  citations Citation[]

  @@index([notebookId])
}

model Citation {
  id       String @id @default(uuid())
  document String
  page     Int
  chapter  String
  snippet  String

  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Summary {
  id           String   @id @default(uuid())
  notebookName String
  type         String
  title        String
  content      String
  bullets      Json
  createdAt    DateTime @default(now())

  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
}

model QuizQuestion {
  id          String  @id @default(uuid())
  question    String
  type        String
  options     Json?
  answer      String
  explanation String
  notebookId  String?
}

model ReferenceLink {
  id       String   @id @default(uuid())
  url      String
  title    String
  category String
  status   String   @default("Indexing")
  addedAt  DateTime @default(now())
}

model CanvasCourse {
  id       String  @id @default(uuid())
  name     String
  code     String
  files    Int     @default(0)
  selected Boolean @default(false)
}
